# 敏感信息
.env
*.keystore
*.jks
# 固定签名 keystore 必须进仓库——CI 用同一把密钥签名，
# 否则每次构建随机生成新密钥，APK 签名不一致导致必须卸载重装
!keystore/debug.keystore

# Android 构建产物
FMPlayer/build/
FMPlayer/app/build/
FMPlayer/.gradle/
FMPlayer/local.properties
*.apk
*.aab

# IDE / 本地工具配置
.idea/
*.iml
.DS_Store
.claude/
CLAUDE.md

# 打包压缩文件（源码在仓库里，不需要再存一份 zip）
*.zip

# 日志和调试文件
fmplayer_debug.txt
fmplayer_crash.txt

# Python 运行缓存（本地跑 fm_backend 测试时产生）
__pycache__/
*.pyc
